# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────────────────────────
#
# Vercel / cloud (recommended): Aiven MySQL
#   1. Aiven console → your service → Overview → copy Service URI
#   2. Firewall: allow 0.0.0.0/0 (required for Vercel serverless)
#   3. Use as-is; ssl-mode=REQUIRED is supported
#   DATABASE_URL=mysql://avnadmin:PASSWORD@mysql-XXXX.h.aivencloud.com:22462/defaultdb?ssl-mode=REQUIRED
#
# cPanel (production on simbapreschool.in):
#   DATABASE_URL=mysql://simbapre_school:PASSWORD@localhost:3306/simbapre_simbaacademy
#
# Local dev against cPanel (Remote MySQL):
#   1. cPanel → Remote MySQL → Add Access Host = your public IP (curl https://api.ipify.org)
#   2. Host: simbapreschool.in
# URL-encode password special chars (@ → %40, ! → %21, # → %23)
# allowPublicKeyRetrieval=true fixes "RSA public key is not available" with Prisma + MySQL/MariaDB
DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@mysql-XXXX.h.aivencloud.com:22462/defaultdb?ssl-mode=REQUIRED
# Generate a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Zoho Payments (India) ───────────────────────────────────────
# Developer Space: API Key + Signing Key | OAuth: Client ID/Secret + Refresh Token
# Dashboard → Settings → copy Account ID
ZOHO_PAYMENTS_ACCOUNT_ID=
ZOHO_PAYMENTS_API_KEY=
ZOHO_PAYMENTS_SIGNING_KEY=
ZOHO_PAYMENTS_CLIENT_ID=
ZOHO_PAYMENTS_CLIENT_SECRET=
ZOHO_PAYMENTS_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_PAYMENTS_API_URL=https://payments.zoho.in/api/v1
ZOHO_PAYMENTS_DOMAIN=IN
# false = production widget (payments.zoho.in) — use with live API keys.
# true  = sandbox widget (paymentssandbox.zoho.in) — requires separate Zoho SANDBOX credentials.
ZOHO_PAYMENTS_TEST_MODE=false
# Set true when Zoho Payments is live — registration requires ₹120 payment before account creation.
PAYMENTS_ENABLED=true
STUDENT_REGISTRATION_FEE_INR=120
# Mock checkout when payments are enabled but Zoho credentials are missing (dev only).
ZOHO_PAYMENTS_PLACEHOLDER=true

# ── Email (SMTP / Brevo) ───────────────────────────────────────
# Brevo → Settings → SMTP & API → copy "Login" (NOT your Gmail) + create SMTP key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=a0ad3f001@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key-here
# Must be a verified sender in Brevo → Senders (e.g. contact@simbapreschool.in)
EMAIL_FROM=contact@simbapreschool.in
EMAIL_TO=info@simbapreschool.in
PLATFORM_NAME=Simba Academy
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_MINUTES=30

# ── Domains (CORS) ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Storage ────────────────────────────────────────────────────
STORAGE_PATH=uploads
MAX_FILE_SIZE=52428800 # 50 MB in bytes

# ── Admin Bootstrap (server-side only) ─────────────────────────
# If DEFAULT_ADMIN_PASSWORD is left blank the admin seed is skipped.
# Use a strong, unique password and change it after first login.
DEFAULT_ADMIN_EMAIL=admin@simbaacademy.in
DEFAULT_ADMIN_PASSWORD=
SYNC_DEFAULT_ADMIN_PASSWORD=false

# Demo teachers / student / leads / approvals (npm run db:seed:demo)
DEMO_SEED_PASSWORD=Simba@Demo2026
# Playwright / local QA (defaults match db:seed:demo)
TEST_STUDENT_EMAIL=demo.student@simbapreschool.in
TEST_STUDENT_PASSWORD=Simba@Demo2026
TEST_TEACHER_EMAIL=priya.teacher@simbapreschool.in
TEST_TEACHER_PASSWORD=Simba@Demo2026

# ── Monitoring (optional — leave blank to disable) ────────────────
SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100

# ── Google Reviews — RECOMMENDED: Business Profile OAuth (full review text) ─
# 1. Google Cloud → OAuth client (Web) → redirect: http://localhost:3001/api/admin/google-reviews/oauth-callback
# 2. Enable: My Business Account Management API, Business Information API, Google My Business API
# 3. Log in as admin → Parent Reviews → Connect Google Business (or paste refresh token below)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/admin/google-reviews/oauth-callback
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
# After quota errors, pause Google Business API calls (minutes). Default 30.

# ── Fallback: Places API (ratings only unless Enterprise SKU) ─────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_IDS=
GOOGLE_PLACES_SEARCH_QUERY=Simba Preschool Salem Tamil Nadu
GOOGLE_PLACES_NAME_FILTER=simba
GOOGLE_PLACES_SEARCH_MAX=20
# false = use saved snapshot (recommended). true = hits Google on every page load.
GOOGLE_REVIEWS_LIVE_FETCH=false
GOOGLE_REVIEWS_CACHE_MINUTES=15
GOOGLE_REVIEWS_SYNC_COOLDOWN_MINUTES=15
GOOGLE_GBP_RATE_LIMIT_COOLDOWN_MINUTES=30
# Run once: npm run google:list-business-account — then paste account id here (avoids quota-heavy accounts.list)
GOOGLE_BUSINESS_ACCOUNT_ID=
