# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (PostgreSQL) ───────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/simba_academy?schema=public

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ── Razorpay ───────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder

# ── Email (SMTP / Brevo) ───────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=placeholder@email.com
SMTP_PASS=placeholder
EMAIL_FROM=noreply@simbapreschool.in
EMAIL_TO=info@simbapreschool.in

# ── Domains (CORS) ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Storage ────────────────────────────────────────────────────
STORAGE_PATH=uploads
MAX_FILE_SIZE=52428800 # 50 MB in bytes

# ── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100
