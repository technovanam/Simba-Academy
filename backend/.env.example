# ── Server Config ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Database (cPanel MySQL / MariaDB / Standard MySQL) ──────────────
DATABASE_URL="mysql://db_user:db_password@localhost:3306/db_name"

# ── JWT Authentication ──────────────────────────────────────────────
# Ensure JWT_SECRET is at least 32 characters long in production
JWT_SECRET="generate_a_secure_random_string_here_at_least_32_chars"
JWT_EXPIRES_IN=7d

# ── Zoho Payments Setup (India) ─────────────────────────────────────
# true = students must pay registration fee (use mock when ZOHO_PAYMENTS_PLACEHOLDER=true)
PAYMENTS_ENABLED=true
ZOHO_PAYMENTS_ACCOUNT_ID="your_zoho_payments_account_id"
ZOHO_PAYMENTS_API_KEY="your_zoho_payments_api_key"
ZOHO_PAYMENTS_SIGNING_KEY="your_zoho_payments_webhook_signing_key"

# Zoho OAuth Credentials (for server-side payment session creation)
ZOHO_PAYMENTS_CLIENT_ID="your_zoho_client_id"
ZOHO_PAYMENTS_CLIENT_SECRET="your_zoho_client_secret"
ZOHO_PAYMENTS_REFRESH_TOKEN="your_zoho_refresh_token"

# Zoho Environment endpoints (default is India - accounts.zoho.in)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_PAYMENTS_API_URL=https://payments.zoho.in/api/v1
ZOHO_PAYMENTS_DOMAIN=IN
# false = production/live Zoho API. true = mock sessions for local dev only.
ZOHO_PAYMENTS_TEST_MODE=false
ZOHO_PAYMENTS_PLACEHOLDER=false

# One-time registration fee in INR
STUDENT_REGISTRATION_FEE_INR=1

# ── Resend Email Configuration ──────────────────────────────────────
# API Key from Resend Dashboard
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_TO="admin@yourdomain.com"
PLATFORM_NAME="Simba Academy"

# ── Frontend Configuration & CORS ────────────────────────────────────
FRONTEND_URL="http://localhost:5173"
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ── File Storage Configuration ───────────────────────────────────────
# Local folder for uploads. On cPanel use ~/uploads (same server as the API).
STORAGE_PATH="uploads"
# cPanel production example:
# STORAGE_PATH="/home1/simapre/uploads"
MAX_FILE_SIZE=52428800 # 50 MB in bytes

# ── Admin Bootstrap Configuration ────────────────────────────────────
DEFAULT_ADMIN_EMAIL="admin@simbaacademy.in"
DEFAULT_ADMIN_PASSWORD="ChooseASecurePasswordForFirstRun!@#"
# If set to true, syncing the default admin password is allowed on restart
SYNC_DEFAULT_ADMIN_PASSWORD=true

# ── API Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in milliseconds
RATE_LIMIT_MAX=100

# ── cPanel Web Disk / WebDAV (optional — off-server API only) ────────
# When the Node API runs ON cPanel, keep USE_WEBDAV=false and use STORAGE_PATH above.
USE_WEBDAV=false
WEBDAV_URL="https://webdisk.yourdomain.com"
WEBDAV_USER="user@yourdomain.com"
WEBDAV_PASSWORD="your_webdav_password"
WEBDAV_REMOTE_PATH="uploads"
WEBDAV_BASE_URL="https://yourdomain.com/uploads"

# ── Google Reviews Integration (Places API New) ─────────────────────
GOOGLE_PLACES_API_KEY="your_google_places_api_key"
# Comma-separated list of Place IDs for all branches (e.g. ChIJDSoT09rx...)
GOOGLE_PLACE_IDS=""
# Optional query to auto-discover branch Place IDs if list is empty
GOOGLE_PLACES_SEARCH_QUERY=""
GOOGLE_PLACES_NAME_FILTER="simba"
GOOGLE_PLACES_SEARCH_MAX=20
GOOGLE_REVIEWS_CACHE_MINUTES=60
GOOGLE_REVIEWS_SYNC_COOLDOWN_MINUTES=15

# Google Business Profile OAuth Details (For retrieving full review text)
GOOGLE_OAUTH_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_OAUTH_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3001/api/admin/google-reviews/oauth-callback"
GOOGLE_BUSINESS_REFRESH_TOKEN="your_google_business_refresh_token"
GOOGLE_BUSINESS_ACCOUNT_ID="your_google_business_account_id"

# ── Monitoring & Sentry ──────────────────────────────────────────────
SENTRY_DSN=""
