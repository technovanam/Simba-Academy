# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (cPanel MySQL/MariaDB) ───────────────────────────────
# Database: simbapre_simbaacademy | User: simbapre_school
#
# Production (backend on cPanel server):
#   DATABASE_URL=mysql://simbapre_school:PASSWORD@localhost:3306/simbapre_simbaacademy
#
# Local dev (from your PC):
#   1. cPanel → Remote MySQL → Add Access Host
#   2. Add YOUR PC's public IP (not the server IP) — run: curl https://api.ipify.org
#   3. Use simbapreschool.in as host (server IP: 157.66.191.9)
# URL-encode password special chars (@ → %40, ! → %21, # → %23)
DATABASE_URL=mysql://simbapre_school:YOUR_DB_PASSWORD@localhost:3306/simbapre_simbaacademy
# Generate a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Razorpay ───────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_SxRFqSpGrwnxk6
RAZORPAY_KEY_SECRET=aF7t8q51KDqzGLCWiQMf24Iu

# ── Email (SMTP / Brevo) ───────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=placeholder@email.com
SMTP_PASS=placeholder
EMAIL_FROM=noreply@simbapreschool.in
EMAIL_TO=info@simbapreschool.in
PLATFORM_NAME=Simba Academy
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_MINUTES=30

# ── Domains (CORS) ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Storage ────────────────────────────────────────────────────
STORAGE_PATH=uploads
MAX_FILE_SIZE=52428800 # 50 MB in bytes

# ── Admin Bootstrap (server-side only) ─────────────────────────
# If DEFAULT_ADMIN_PASSWORD is left blank the admin seed is skipped.
# Use a strong, unique password and change it after first login.
DEFAULT_ADMIN_EMAIL=admin@simbaacademy.in
DEFAULT_ADMIN_PASSWORD=
SYNC_DEFAULT_ADMIN_PASSWORD=false

RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100
