# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (cPanel MySQL/MariaDB) ───────────────────────────────
# Database: simbapre_simbaacademy | User: simbapre_school
#
# Production (backend on cPanel server):
#   DATABASE_URL=mysql://simbapre_school:PASSWORD@localhost:3306/simbapre_simbaacademy
#
# Local dev (from your PC):
#   1. cPanel → Remote MySQL → Add Access Host
#   2. Add YOUR PC's public IP (not the server IP) — run: curl https://api.ipify.org
#   3. Use simbapreschool.in as host (server IP: 157.66.191.9)
# URL-encode password special chars (@ → %40, ! → %21, # → %23)
# allowPublicKeyRetrieval=true fixes "RSA public key is not available" with Prisma + MySQL/MariaDB
DATABASE_URL=mysql://simbapre_school:YOUR_DB_PASSWORD@localhost:3306/simbapre_simbaacademy?allowPublicKeyRetrieval=true
# Generate a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Zoho Payments (India) ───────────────────────────────────────
# Developer Space: API Key + Signing Key | OAuth: Client ID/Secret + Refresh Token
# Dashboard → Settings → copy Account ID
ZOHO_PAYMENTS_ACCOUNT_ID=
ZOHO_PAYMENTS_API_KEY=
ZOHO_PAYMENTS_SIGNING_KEY=
ZOHO_PAYMENTS_CLIENT_ID=
ZOHO_PAYMENTS_CLIENT_SECRET=
ZOHO_PAYMENTS_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_PAYMENTS_API_URL=https://payments.zoho.in/api/v1
ZOHO_PAYMENTS_DOMAIN=IN
ZOHO_PAYMENTS_TEST_MODE=false
# Set true for local dev without Zoho credentials (mock checkout).
# Also use while Zoho account shows payments_not_enabled until support activates collection.
ZOHO_PAYMENTS_PLACEHOLDER=true

# ── Email (SMTP / Brevo) ───────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=placeholder@email.com
SMTP_PASS=placeholder
EMAIL_FROM=noreply@simbapreschool.in
EMAIL_TO=info@simbapreschool.in
PLATFORM_NAME=Simba Academy
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_MINUTES=30

# ── Domains (CORS) ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Storage ────────────────────────────────────────────────────
STORAGE_PATH=uploads
MAX_FILE_SIZE=52428800 # 50 MB in bytes

# ── Admin Bootstrap (server-side only) ─────────────────────────
# If DEFAULT_ADMIN_PASSWORD is left blank the admin seed is skipped.
# Use a strong, unique password and change it after first login.
DEFAULT_ADMIN_EMAIL=admin@simbaacademy.in
DEFAULT_ADMIN_PASSWORD=
SYNC_DEFAULT_ADMIN_PASSWORD=false

# Demo teachers / leads / approvals (npm run db:seed:demo)
DEMO_SEED_PASSWORD=Simba@Demo2026

RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100

# ── Google Reviews — RECOMMENDED: Business Profile OAuth (full review text) ─
# 1. Google Cloud → OAuth client (Web) → redirect: http://localhost:3001/api/admin/google-reviews/oauth-callback
# 2. Enable: My Business Account Management API, Business Information API, Google My Business API
# 3. Log in as admin → Parent Reviews → Connect Google Business (or paste refresh token below)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/admin/google-reviews/oauth-callback
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
# After quota errors, pause Google Business API calls (minutes). Default 30.
GOOGLE_GBP_RATE_LIMIT_COOLDOWN_MINUTES=30

# ── Fallback: Places API (ratings only unless Enterprise SKU) ─────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_IDS=
GOOGLE_PLACES_SEARCH_QUERY=Simba Preschool Salem Tamil Nadu
GOOGLE_PLACES_NAME_FILTER=simba
GOOGLE_PLACES_SEARCH_MAX=20
GOOGLE_REVIEWS_CACHE_MINUTES=60
GOOGLE_REVIEWS_SYNC_COOLDOWN_MINUTES=15
