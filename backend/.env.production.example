# Simba Academy API — cPanel production template
# Copy to .env on server OR use the pre-built .env inside simba-api.zip

NODE_ENV=production
PORT=3001

# cPanel MySQL (localhost on server)
DATABASE_URL="mysql://simbapre_school:YOUR_DB_PASSWORD@localhost:3306/simbapre_simbaacademy?allowPublicKeyRetrieval=true"

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Zoho Payments (India)
ZOHO_PAYMENTS_ACCOUNT_ID=
ZOHO_PAYMENTS_API_KEY=
ZOHO_PAYMENTS_SIGNING_KEY=
ZOHO_PAYMENTS_CLIENT_ID=
ZOHO_PAYMENTS_CLIENT_SECRET=
ZOHO_PAYMENTS_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_PAYMENTS_API_URL=https://payments.zoho.in/api/v1
ZOHO_PAYMENTS_DOMAIN=IN
ZOHO_PAYMENTS_TEST_MODE=false
ZOHO_PAYMENTS_PLACEHOLDER=false
PAYMENTS_ENABLED=true
STUDENT_REGISTRATION_FEE_INR=120

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=contact@simbapreschool.in
EMAIL_TO=contact@simbapreschool.in
PLATFORM_NAME=Simba Academy
FRONTEND_URL=https://simbapreschool.in
PUBLIC_API_URL=https://simbapreschool.in/backend
PASSWORD_RESET_EXPIRES_MINUTES=30

ALLOWED_ORIGINS=https://simbapreschool.in,https://www.simbapreschool.in

MAX_FILE_SIZE=52428800

DEFAULT_ADMIN_EMAIL=admin@simbaacademy.in
DEFAULT_ADMIN_PASSWORD=
SYNC_DEFAULT_ADMIN_PASSWORD=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000

USE_WEBDAV=false

# Google Reviews / Business Profile (optional)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_IDS=
GOOGLE_OAUTH_REDIRECT_URI=https://simbapreschool.in/backend/api/admin/google-reviews/oauth-callback
GOOGLE_SERVICE_ACCOUNT_JSON=google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=
