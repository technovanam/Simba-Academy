{
  "name": "simba-academy-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:check": "node scripts/check-db.mjs",
    "db:migrate-payments": "node scripts/migrate-schema.mjs",
    "db:migrate-schema": "node scripts/migrate-schema.mjs",
    "db:verify-admin": "node scripts/verify-admin-data.mjs",
    "db:migrate-storybook-audience": "node scripts/migrate-storybook-audience.mjs",
    "storage:check": "node scripts/check-storage.mjs",
    "google:find-place": "node scripts/find-google-place-id.mjs",
    "google:list-places": "node scripts/find-google-place-id.mjs",
    "google:connect-business": "node scripts/print-google-business-auth-url.mjs",
    "google:list-business-account": "node scripts/google-list-business-account.mjs",
    "google:sync-reviews": "npx tsx scripts/google-sync-reviews.mjs",
    "reviews:report": "npx tsx scripts/reviews-report.mjs",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/config/seedAdmin.ts",
    "db:seed:demo": "tsx src/config/seedDemo.ts",
    "db:purge-teachers": "node scripts/purge-teachers.mjs",
    "production": "npm run build && prisma db push && npm start",
    "deploy:cpanel": "npm run build && prisma db push",
    "deploy:pack": "node scripts/cpanel-pack.mjs",
    "deploy:cpanel:start": "node dist/index.js",
    "deploy:vercel": "npm run build"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.56.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "prisma": "^7.8.0",
    "serverless-http": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.0",
    "pm2": "^7.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
