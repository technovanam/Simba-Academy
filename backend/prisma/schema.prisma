// ── Generator & Datasource ──────────────────────────────────────────
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
}

// ── User ────────────────────────────────────────────────────────────
enum Role {
  ADMIN
  TEACHER
  STUDENT

  @@map("user_role")
}

enum AccountStatus {
  ACTIVE
  DEACTIVATED

  @@map("user_status")
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  password           String
  name               String
  firstName          String?
  lastName           String?
  role               Role          @default(STUDENT)
  phone              String?
  /** Student class for story books & materials — Playgroup, Pre-KG, LKG, UKG */
  studentClass       String?
  employeeId         String?       @unique
  status             AccountStatus @default(ACTIVE)
  mustChangePassword Boolean       @default(false)
  isDeleted          Boolean       @default(false)
  deletedAt          DateTime?
  createdBy          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payments             Payment[]
  uploadedFiles        Material[]
  sentInquiries        Inquiry[]
  tasks                Task[]                @relation("TeacherTasks")
  passwordResetTokens  PasswordResetToken[]
  notifications        StudentNotification[]
  teacherNotifications TeacherNotification[]

  @@map("user")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("passwordresettoken")
}

// ── Course ──────────────────────────────────────────────────────────
model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  level       String
  price       Float?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materials   Material[]
  payments    Payment[]
  lessonPlans LessonPlan[]

  @@map("course")
}

// ── Material (PDF / PPT / Resources) ────────────────────────────────
model Material {
  id           String   @id @default(cuid())
  title        String
  description  String?
  type         String
  fileUrl      String
  fileSize     Int?
  isApproved   Boolean  @default(false)
  courseId     String
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@map("material")
}

// ── Payment (Zoho Payments) ─────────────────────────────────────────
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED

  @@map("payment_status")
}

model Payment {
  id               String        @id @default(cuid())
  amount           Float
  currency         String        @default("INR")
  status           PaymentStatus @default(PENDING)
  paymentSessionId String?       @unique
  gatewayPaymentId String?       @unique
  paymentSignature String?
  userId           String
  courseId         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@map("payment")
}

// ── Contact / Inquiry ───────────────────────────────────────────────
model Inquiry {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  isRead    Boolean   @default(false)
  repliedAt DateTime?
  userId    String?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("inquiry")
}

// ── Testimonial ─────────────────────────────────────────────────────
model Testimonial {
  id         String   @id @default(cuid())
  name       String
  content    String
  rating     Int      @default(5)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("testimonial")
}

// ── Gallery / Media ─────────────────────────────────────────────────
model Gallery {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  type      String   @default("IMAGE")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("gallery")
}

// ── Franchise Inquiry ───────────────────────────────────────────────
model FranchiseInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  location  String?
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("franchiseinquiry")
}

// ── Teacher Tasks (Assigned by Admin) ───────────────────────────────
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("PENDING")
  proofUrl    String?
  proofDesc   String?
  teacherId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  teacher       User                  @relation("TeacherTasks", fields: [teacherId], references: [id], onDelete: Cascade)
  notifications TeacherNotification[]

  @@map("task")
}

// ── Lesson Plans (Admin creates, teachers view) ─────────────────────
model LessonPlan {
  id              String    @id @default(cuid())
  title           String
  courseId        String?
  planDate        DateTime?
  content         String    @db.Text
  materialsNeeded String?   @db.Text
  isPublished     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  course        Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  notifications TeacherNotification[]

  @@map("lessonplan")
}

// ── Story Books (Children Library) ──────────────────────────────────
enum LibraryAudience {
  STUDENT
  TEACHER
  BOTH

  @@map("storybook_audience")
}

model StoryBook {
  id        String          @id @default(cuid())
  title     String
  author    String?
  category  String
  fileUrl   String
  fileSize  Int?
  audience  LibraryAudience @default(BOTH)
  createdAt DateTime        @default(now())

  studentNotifications StudentNotification[]
  teacherNotifications TeacherNotification[]

  @@map("storybook")
}

// ── Student in-app notifications ────────────────────────────────────
model StudentNotification {
  id          String   @id @default(cuid())
  userId      String
  type        String   @default("STORY_BOOK")
  title       String
  message     String   @db.Text
  storyBookId String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyBook StoryBook? @relation(fields: [storyBookId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("studentnotification")
}

// ── Teacher in-app notifications ────────────────────────────────────
model TeacherNotification {
  id           String   @id @default(cuid())
  userId       String
  type         String   @default("STORY_BOOK")
  title        String
  message      String   @db.Text
  storyBookId  String?
  taskId       String?
  lessonPlanId String?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyBook  StoryBook?  @relation(fields: [storyBookId], references: [id], onDelete: SetNull)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  lessonPlan LessonPlan? @relation(fields: [lessonPlanId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("teachernotification")
}
