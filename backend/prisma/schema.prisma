// ── Generator & Datasource ──────────────────────────────────────────
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ── User ────────────────────────────────────────────────────────────
enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum AccountStatus {
  ACTIVE
  DEACTIVATED
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  password           String
  name               String
  firstName          String?
  lastName           String?
  role               Role          @default(STUDENT)
  phone              String?
  /** Student class for story books & materials — Playgroup, Pre-KG, LKG, UKG */
  studentClass       String?
  employeeId         String?       @unique
  status             AccountStatus @default(ACTIVE)
  mustChangePassword Boolean       @default(false)
  isDeleted          Boolean       @default(false)
  deletedAt          DateTime?
  createdBy          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payments             Payment[]
  uploadedFiles        Material[]
  sentInquiries        Inquiry[]
  tasks                Task[]                @relation("TeacherTasks")
  passwordResetTokens  PasswordResetToken[]
  notifications        StudentNotification[]
  teacherNotifications TeacherNotification[]
  adminNotifications   AdminNotification[]
  auditLogs            AuditLog[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── Course ──────────────────────────────────────────────────────────
model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  level       String
  price       Float?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materials   Material[]
  payments    Payment[]
  lessonPlans LessonPlan[]
}

// ── Material (PDF / PPT / Resources) ────────────────────────────────
model Material {
  id           String   @id @default(cuid())
  title        String
  description  String?
  type         String
  fileUrl      String
  fileSize     Int?
  isApproved   Boolean  @default(false)
  courseId     String
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}

// ── Payment (Zoho Payments) ─────────────────────────────────────────
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id               String        @id @default(cuid())
  amount           Float
  currency         String        @default("INR")
  status           PaymentStatus @default(PENDING)
  paymentSessionId String?       @unique
  gatewayPaymentId String?       @unique
  paymentSignature String?
  userId           String
  courseId         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  adminNotifications   AdminNotification[]
}

// ── Contact / Inquiry ───────────────────────────────────────────────
model Inquiry {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  isRead    Boolean   @default(false)
  repliedAt DateTime?
  userId    String?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ── Testimonial ─────────────────────────────────────────────────────
model Testimonial {
  id         String   @id @default(cuid())
  name       String
  content    String
  rating     Int      @default(5)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Gallery / Media ─────────────────────────────────────────────────
model Gallery {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  type      String   @default("IMAGE")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ── Franchise Inquiry ───────────────────────────────────────────────
model FranchiseInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  location  String?
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ── Recurring Teacher Tasks (Class-Based) ───────────────────────────
model RecurringTask {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  studentClass String
  repeatDay    String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks        Task[]
}

// ── Teacher Tasks (Assigned by Admin or Recurring) ──────────────────
model Task {
  id               String    @id @default(cuid())
  title            String
  description      String?   @db.Text
  dueDate          DateTime?
  status           String    @default("PENDING")
  proofUrl         String?
  proofDesc        String?   @db.Text
  proofSubmittedAt DateTime?
  teacherId        String
  recurringTaskId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  teacher            User                  @relation("TeacherTasks", fields: [teacherId], references: [id], onDelete: Cascade)
  recurringTask      RecurringTask?        @relation(fields: [recurringTaskId], references: [id], onDelete: SetNull)
  notifications      TeacherNotification[]
  adminNotifications AdminNotification[]
}

// ── Lesson Plans (Admin creates, teachers view) ─────────────────────
model LessonPlan {
  id              String    @id @default(cuid())
  title           String
  targetClass     String?   // Class this plan is assigned to (e.g. Playgroup, Pre-KG, LKG, UKG)
  courseId        String?
  planDate        DateTime?
  content         String    @db.Text
  materialsNeeded String?   @db.Text
  isPublished     Boolean   @default(true)
  fileUrl         String?
  fileName        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  course        Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  notifications TeacherNotification[]
}

// ── Story Books (Children Library) ──────────────────────────────────
enum LibraryAudience {
  STUDENT
  TEACHER
  BOTH
}

// ── Library Folders (Google Drive-style) ────────────────────────────
model LibraryFolder {
  id        String          @id @default(cuid())
  name      String
  parentId  String?
  audience  LibraryAudience @default(BOTH)
  category  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  parent    LibraryFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  LibraryFolder[] @relation("FolderTree")
  storyBooks StoryBook[]

  @@index([parentId])
}

model DriveAccessRule {
  id          String          @id @default(cuid())
  fileId      String          @unique
  audience    LibraryAudience @default(BOTH)
  targetClass String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([fileId])
}

model StoryBook {
  id        String          @id @default(cuid())
  title     String
  author    String?
  category  String
  fileUrl   String
  fileSize  Int?
  audience  LibraryAudience @default(BOTH)
  folderId  String?
  createdAt DateTime        @default(now())

  folder               LibraryFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  studentNotifications StudentNotification[]
  teacherNotifications TeacherNotification[]

  @@index([folderId])
}

// ── Student in-app notifications ────────────────────────────────────
model StudentNotification {
  id          String   @id @default(cuid())
  userId      String
  type        String   @default("STORY_BOOK")
  title       String
  message     String   @db.Text
  storyBookId String?
  isRead      Boolean  @default(false)
  readingStatus String @default("UNREAD")
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyBook StoryBook? @relation(fields: [storyBookId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ── Teacher in-app notifications ────────────────────────────────────
model TeacherNotification {
  id           String   @id @default(cuid())
  userId       String
  type         String   @default("STORY_BOOK")
  title        String
  message      String   @db.Text
  storyBookId  String?
  taskId       String?
  lessonPlanId String?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyBook  StoryBook?  @relation(fields: [storyBookId], references: [id], onDelete: SetNull)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  lessonPlan LessonPlan? @relation(fields: [lessonPlanId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ── Google Review (GBP Sync) ────────────────────────────────────────
model GoogleReview {
  reviewId         String   @id // The unique reviewId from Google
  reviewerName     String
  reviewerPhotoUrl String?  @db.Text
  comment          String   @db.Text
  rating           Int
  locationId       String   // Extracted branch location ID
  createTime       DateTime
  updateTime       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([locationId])
  @@index([updateTime])
}

// ── Admin in-app notifications ──────────────────────────────────────
model AdminNotification {
  id        String   @id @default(cuid())
  type      String   // e.g. "TASK_PROOF", "PAYMENT_SUCCESS", "STUDENT_REGISTER"
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  paymentId String?
  taskId    String?
  userId    String?

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // e.g. "FILE_UPLOAD", "FILE_DELETE", "FILE_RENAME", "FOLDER_CREATE", "FILE_VIEW", "FILE_DOWNLOAD"
  details   String   @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}



