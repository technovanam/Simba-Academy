{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build && npx prisma generate",
  "builds": [
    {
      "src": "api/handler.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/handler.ts"
    }
  ],
  "functions": {
    "api/handler.ts": {
      "maxDuration": 60,
      "includeFiles": "dist/**"
    }
  }
}
