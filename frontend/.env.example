# ── Backend Connection ────────────────────────────────────────────────
# Backend base URL only — do NOT include /api (request paths already start with /api/...)
# Local:  http://localhost:3001
# Prod:   https://yourdomain.in/backend
VITE_API_URL=http://localhost:3001

# ── Student payments (Zoho Payments India) ───────────────────────────
# Live Zoho checkout widget (requires backend ZOHO_PAYMENTS_PLACEHOLDER=false)
VITE_PAYMENTS_LIVE_ZOHO=true
VITE_PAYMENTS_MOCK=false
# Local demo checkout without Zoho:
# VITE_PAYMENTS_LIVE_ZOHO=false
# VITE_PAYMENTS_MOCK=true

# ── Setup Configurations ──────────────────────────────────────────────
# Setup key to bootstrap first-time administrators from front-end pages
VITE_ADMIN_SETUP_KEY=simba-admin-setup-2026

# ── Analytics & Monitoring (Optional) ──────────────────────────────────
# PostHog API Key
VITE_POSTHOG_KEY=""
# Sentry DSN for error reporting
VITE_SENTRY_DSN=""
